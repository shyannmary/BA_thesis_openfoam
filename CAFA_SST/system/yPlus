Description
    Calculates the turbulence y+, outputting the data as a yPlus field.

\*---------------------------------------------------------------------------*/

yPlus
{
    type            yPlus;                       // for RANS turbulence
    libs            ("libfieldFunctionObjects.so"); // correct library
    executeControl  timeStep;                       // run every time step
    executeInterval 50;                              // every timestep
    writeControl    timeStep;                       // write every timestep
    writeInterval   50;                              // write every timestep
    log             true;                           

    patches
    (
        motorBikeGroup
    );
}


