FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nuTilda;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 1.5e-4;

boundaryField
{
    inlet
    {
        type            freestream;
        freestreamValue $internalField;
    }

    outlet
    {
         type            freestream;
         freestreamValue $internalField;
    }

    motorBikeGroup
    {
        type            fixedValue;
        value           uniform 0;
    }


    #include "include/frontBackUpperPatches"
     symmetryPlane1
    {
        type symmetry;
    }
}


